# =============================================================================
# Feynman — Environment Variables
# Copy to .env and fill in your values
# =============================================================================

# --- LLM Providers ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
# Gemini: data_pre_compute_v2 ingestion accepts GEMINI_API_KEY or GOOGLE_API_KEY
GEMINI_API_KEY=

# --- LiveKit ---
# Local dev on ONE machine: the bundled Docker LiveKit on localhost is fine.
# SHARING TO REMOTE USERS (ngrok / cohort): localhost is UNREACHABLE from a
# remote browser — WebRTC connects DIRECTLY and bypasses the tunnel, so live
# "Ask Feynman" voice doubts silently fail for everyone. Fix = LiveKit Cloud
# (free tier): set all three below to your project's values AND set
# VITE_LIVEKIT_URL in frontend/.env.local to the same wss:// URL. See SHARING.md.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# --- Speech Providers ---
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# Config-driven TTS options: "cartesia", "elevenlabs", or "openai"
TTS_PROVIDER=cartesia
TTS_MODEL=
TTS_VOICE=

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://feynman:feynman@localhost:5433/feynman

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=DEBUG
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# --- Curriculum mode ---
# When true (default), the agent loads a curriculum graph from Neo4j at session
# start. Topics not in the graph fail the session with CurriculumNotFoundError.
# When false, Neo4j is skipped — the agent runs in free-form mode (no plan,
# no pre-generated visuals, no doubt-resolution checklist). Useful for local
# testing of the doubt orchestrator without seeding Neo4j.
USE_NEO4J_CURRICULUM=true
