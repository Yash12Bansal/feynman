# =============================================================================
# Feynman — Environment Variables
# Copy to .env and fill in your values
# =============================================================================

# --- LLM Providers ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# --- LiveKit ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# --- Speech Providers ---
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://feynman:feynman@localhost:5432/feynman

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=DEBUG
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
