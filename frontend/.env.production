# Frontend production build config (consumed by `vite build`).
# NOTE: Firebase web config values are PUBLIC by design (they ship in every
# client bundle); security is enforced by Firebase rules + authorized domains,
# not by hiding these. Safe to commit.

# Real-time voice (already a LiveKit Cloud project)
VITE_LIVEKIT_URL=wss://feynman-qz4fiboi.livekit.cloud

# Same-origin API paths — Firebase Hosting rewrites /api -> backend Cloud Run,
# /lecture-api -> preview Cloud Run. No absolute URLs needed.
VITE_API_BASE_URL=/api

# Firebase (project: feynman-basic)
VITE_FIREBASE_API_KEY=AIzaSyAfr5IZUXYpCdh1yGOvbgn_SMq7FtnxY10
VITE_FIREBASE_AUTH_DOMAIN=feynman-basic.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=feynman-basic
VITE_FIREBASE_STORAGE_BUCKET=feynman-basic.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=46859730090
VITE_FIREBASE_APP_ID=1:46859730090:web:a23e501f90ed929b5c24d3
VITE_FIREBASE_MEASUREMENT_ID=G-FM6THN58W8

# Auth gate ON in production; split-board renderer ON.
VITE_AUTH_DISABLED=false
VITE_SPLIT_BOARD=true
