# Frontend environment reference.
# Copy to `.env.local` and fill in. `.env.local` is gitignored — never commit it.

# ── Existing app config ──────────────────────────────────────────
VITE_LIVEKIT_URL=ws://localhost:7880
VITE_API_BASE_URL=/api
# VITE_SPLIT_BOARD=true   # default ON; set false for the legacy renderer

# ── Auth gate (local dev) ────────────────────────────────────────
# Set true to bypass Google sign-in entirely while developing locally.
# Leave false (or unset) for the cohort build — the product must gate.
VITE_AUTH_DISABLED=false

# ── Firebase: Google sign-in + Firestore feedback store ──────────
# Firebase console → Project settings → "Your apps" → Web app → SDK setup.
# These values are PUBLIC by design; Firestore security rules are the guard
# (see AUTH_FEEDBACK_SETUP.md). The gate stays inert until API_KEY +
# PROJECT_ID + APP_ID are all present.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional — enables Google Analytics if present (best-effort, browser-only).
VITE_FIREBASE_MEASUREMENT_ID=
